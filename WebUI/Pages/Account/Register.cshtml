@page
@model WebUI.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Create customer account";
}

<div class="page-heading">
    <div>
        <div class="page-kicker">Customer account</div>
        <h1>Create your GoBike profile</h1>
        <p class="page-subtitle">Register your identity and driving licence details.</p>
    </div>
    <a asp-page="./Login" class="btn btn-outline-secondary">Sign in</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="post" class="content-card">
    <div class="card-body p-4">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Input.Username" class="form-label"></label>
                <input asp-for="Input.Username" class="form-control" autocomplete="username" />
                <span asp-validation-for="Input.Username" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.FullName" class="form-label">Full name</label>
                <input asp-for="Input.FullName" class="form-control" autocomplete="name" />
                <span asp-validation-for="Input.FullName" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.Password" class="form-label"></label>
                <input asp-for="Input.Password" type="password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.ConfirmPassword" class="form-label">Confirm password</label>
                <input asp-for="Input.ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.PhoneNumber" class="form-label">Phone number</label>
                <input asp-for="Input.PhoneNumber" class="form-control" autocomplete="tel" />
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Input.CCCD" class="form-label">CCCD</label>
                <input asp-for="Input.CCCD" class="form-control" inputmode="numeric" />
                <span asp-validation-for="Input.CCCD" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Input.DateOfBirth" class="form-label">Date of birth</label>
                <input asp-for="Input.DateOfBirth" type="date" class="form-control" />
                <span asp-validation-for="Input.DateOfBirth" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Input.DriverLicenseNo" class="form-label">Driver licence</label>
                <input asp-for="Input.DriverLicenseNo" class="form-control" />
                <span asp-validation-for="Input.DriverLicenseNo" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Input.Address" class="form-label"></label>
                <input asp-for="Input.Address" class="form-control" autocomplete="street-address" />
                <span asp-validation-for="Input.Address" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="card-footer d-flex justify-content-end gap-2 p-3">
        <a asp-page="/Motorcycle/Index" class="btn btn-outline-secondary">Continue as guest</a>
        <button type="submit" class="btn btn-primary">Create account</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
